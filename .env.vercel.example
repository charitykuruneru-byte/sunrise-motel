# Vercel deploy checklist (run from this folder; live tunnel on :3000 is NOT touched)
#
# Broadcast push needs ONE more env var (paste whole service-account JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Without it, /admin/notifications honestly reports "NOT sent".
FIREBASE_SERVICE_ACCOUNT_JSON=<paste-service-account-json>
#
# 1) Push code (already committed):
#      git push -u origin main            # after: git remote add origin <your-github-url>
#
# 2) Free hosted Postgres (Neon): https://neon.tech
#      Create project sunrise-db -> copy connection string, e.g.
#      postgresql://user:pass@ep-xxx.neon.tech/sunrise_db?sslmode=require
#      Migrate it locally (writes tables + seed runs on first /api/availability hit):
#      $env:DATABASE_URL='<neon-string>'; npx drizzle-kit migrate
#
# 3) Vercel: https://vercel.com/new -> Import sunrise-motel repo
#      Env vars to add in Vercel dashboard (Project Settings -> Environment Variables):
DATABASE_URL=<paste-neon-string-with-sslmode-require>
# Public domain used inside EMAILS (track links, manager portal links).
# Set BOTH to the same value so guests never get localhost links.
PUBLIC_APP_URL=https://<your-vercel-app>.vercel.app
NEXT_PUBLIC_APP_URL=https://<your-vercel-app>.vercel.app
ADMIN_PASSWORD=Sunrise@2026
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=willardkulemeka8@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM="Sunrise Motel <willardkulemeka8@gmail.com>"
FROM_NAME=Sunrise Motel Reservations
FROM_EMAIL=willardkulemeka8@gmail.com
ADMIN_EMAIL=gracekuruneru@gmail.com
STAFF_WHATSAPP_GROUP=https://wa.me/265998688332
PG_POOL_MAX=5
#      Then Deploy. Health check: https://<your-vercel-app>.vercel.app/api/health -> {"ok":true}
#
# NOTE: manager uploads (Admin -> Pictures) save to ./uploads, which is ephemeral on
# Vercel (wiped on each deploy). Seed images in /public/images always work.
#
# LOCAL tunnel tip: to make the tunnel share the same public link in emails,
# set PUBLIC_APP_URL=https://<your-tunnel>.trycloudflare.com in .env and restart.
