{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3112",
    "build": "next build",
    "start": "next start --port 3112",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:media": "node scripts/verify-media-flow.mjs",
    "verify:sw": "node scripts/verify-service-worker.mjs",
    "verify:update-card": "node scripts/verify-update-card.mjs",
    "verify:identity": "node --no-warnings scripts/verify-guest-identity.mjs",
    "preview:accounts": "node --no-warnings scripts/create-preview-accounts.mjs",
    "preview:accounts:delete": "node --no-warnings scripts/create-preview-accounts.mjs --delete",
    "verify:preview": "node --no-warnings scripts/verify-preview-logins.mjs",
    "vercel-build": "npx drizzle-kit migrate --config=drizzle.config.ts && next build"
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@types/nodemailer": "^8.0.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
