# dependencies
node_modules/
# next.js
.next/
# verification builds: `NEXT_DIST_DIR=".next-verify" npx next build` (see next.config.ts)
.next-*/
out/
# production
dist/
build/
# env (NEVER commit real secrets — set them in the host dashboard instead)
.env
.env*.local
.env.neon.backup
# neon local linking + skills cache
.neon
.agents/
skills-lock.json
# tunnel / local tooling
bin/
# every local server / tunnel log, whatever the script that wrote it called itself
*.log
# throwaway inspection scripts — real tooling lives in scripts/ and is committed by name
scripts/tmp-*
# build metadata (regenerated by tsc --noEmit, never worth a diff)
*.tsbuildinfo
# android: restored from the GOOGLE_SERVICES_JSON repo secret at build time
SunriseMotelApp/app/google-services.json
# misc
.DS_Store
*.pem

# android release signing - the keystore is the app identity FOREVER;
# CI restores it from the KEYSTORE_BASE64 repo secret
*.jks
*.keystore
