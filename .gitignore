# dependencies
node_modules/
# next.js
.next/
# verification builds: `NEXT_DIST_DIR=".next-verify" npx next build` (see next.config.ts)
.next-*/
out/
# production
dist/
build/
# env (NEVER commit real secrets — set them in the host dashboard instead)
.env
.env*.local
.env.neon.backup
# neon local linking + skills cache
.neon
.agents/
skills-lock.json
# tunnel / local tooling
bin/
# every local server / tunnel log, whatever the script that wrote it called itself
*.log
# throwaway inspection scripts — real tooling lives in scripts/ and is committed by name
scripts/tmp-*
scripts/_*
# build metadata (regenerated by tsc --noEmit, never worth a diff)
*.tsbuildinfo
# scratch output from a verification run (every one of these is piped to a file
# and read once — *.log above catches most of them, these are the stragglers)
*-out.txt
# android: restored from the GOOGLE_SERVICES_JSON repo secret at build time
SunriseMotelApp/app/google-services.json
# The raw photo drop that public/media/organized/ was built from: the same pictures,
# under their camera filenames, sitting in the project root. They are kept on disk for
# the next `node scripts/analyze-media.mjs` run, but they are not served from `/`, so
# committing them would add ~18 MB to every clone to publish nothing. `git add .` used
# to sweep them in silently — root-anchored so public/media/** is never touched.
/WhatsApp Image *.jpeg
/caption*.jpg
/cute-and-cozy-place-friendly*.jpg
/520576*.jpg
/520596*.jpg
/691294*.jpg
/691295*.jpg
/691296*.jpg
/Spacious_rooms__*.mp4
# the APK build output, when a local gradle run leaves it here
/*.apk

# misc
.DS_Store
*.pem

# android release signing - the keystore is the app identity FOREVER;
# CI restores it from the KEYSTORE_BASE64 repo secret
*.jks
*.keystore
